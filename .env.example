# Server & Client URLs
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Security Secrets
JWT_SECRET=super-secret-jwt-key-for-development-change-in-prod-12345678
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Queue
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/meeting_actions?schema=public
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Microservices
DIARIZATION_SERVICE_URL=http://localhost:8000

# External API Integrations (Fill these in for production integration)
GEMINI_API_KEY=
HF_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/api/integrations/notion/callback

# STT Provider ("mock", "whisper", or "cloud")
STT_PROVIDER=mock
STT_API_KEY=

# Privacy & Retention
DELETE_RAW_AUDIO=false
AUDIO_RETENTION_HOURS=24
